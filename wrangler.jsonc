{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jotrip-trip",
  "compatibility_date": "2026-09-22",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }

  // Bind D1 only after the first Worker deployment succeeds.
  // ,"d1_databases": [{
  //   "binding": "DB",
  //   "database_name": "jotripa-trip-db",
  //   "database_id": "PASTE_REAL_D1_DATABASE_UUID"
  // }]

  // Add only after trip.jotrip.vn is moved away from its current GitHub/P.A Vietnam target.
  // ,"routes": [{
  //   "pattern": "trip.jotrip.vn",
  //   "custom_domain": true
  // }]
}
